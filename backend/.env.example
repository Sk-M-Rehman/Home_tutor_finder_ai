# Copy this file to ".env" (same folder as pom.xml) and fill in real values. Never commit ".env".
DB_URL=jdbc:mysql://localhost:3306/home_tutor_finder
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MINUTES=60
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3001

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gemini AI chatbot. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# Registration welcome emails (Gmail: use a Google App Password, not your login password)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM=your_email@example.com
